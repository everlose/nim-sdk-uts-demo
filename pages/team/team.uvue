<template>
	<scroll-view class="page" :scroll-y="true">
		<view class="panel">
			<text class="title">群</text>
			<text class="sub-title">保留 5 个常用接口。</text>
		</view>

		<view class="panel">
			<text class="panel-title">参数</text>
			<view class="field">
				<text class="label">群 ID</text>
				<input class="input" :value="teamId" @input="onTeamIdInput" />
			</view>
			<view class="field">
				<text class="label">群名称</text>
				<input class="input" :value="name" @input="onNameInput" />
			</view>
			<view class="field">
				<text class="label">成员账号</text>
				<input class="input" :value="memberAccountId" @input="onMemberAccountIdInput" />
			</view>
			<view class="field">
				<text class="label">监听状态</text>
				<text class="state-text" :class="listenerEnabled ? 'state-on' : 'state-off'">
					{{ listenerEnabled ? '已开启' : '未开启' }}
				</text>
			</view>
			<textarea class="listener-box" :value="listenerText" disabled />
		</view>

		<view class="panel">
			<text class="panel-title">接口</text>
			<button class="action-btn action-primary" @tap="handleCreateTeam">创建群</button>
			<button class="action-btn action-primary" @tap="handleGetJoinedTeamList">获取已加入群列表</button>
			<button class="action-btn action-primary" @tap="handleGetTeamInfo">获取群资料</button>
			<button class="action-btn action-primary" @tap="handleGetTeamMemberList">获取群成员列表</button>
			<button class="action-btn" @tap="toggleListener">{{ listenerEnabled ? '关闭监听' : '开启监听' }}</button>
		</view>

		<view class="panel result-panel">
			<text class="panel-title">结果</text>
			<textarea class="result-box" :value="resultText" disabled />
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import {
		V2NIMTeamListener,
		V2NIMTeamService
	} from '@/uni_modules/nim-uts-sdk'
	import { getStoredString, setStoredString } from '../common/demo-utils.uts'

	const teamId = ref('' as string)
	const name = ref(getStoredString('demo_team_name', 'demo team') as string)
	const memberAccountId = ref('' as string)
	const listenerEnabled = ref(false as boolean)
	const resultText = ref('暂无结果' as string)
	const listenerText = ref('暂无监听内容' as string)

	let teamService : V2NIMTeamService | null = null

	// 蒸汽模式下页面逻辑层是 JS，插件不再导出枚举对象。
	// 当前 SDK 的群接口已经接收 any 并在插件内部把数字归一化成原生枚举，
	// 页面直接传数字 / 对象字面量即可，不再需要 builder 或平台分支。
	const TEAM_TYPE_NORMAL : number = 1
	let teamListener : V2NIMTeamListener | null = null

	const ensureService = () : V2NIMTeamService => {
		if (teamService == null) {
			teamService = new V2NIMTeamService()
		}
		return teamService!
	}

	const onTeamIdInput = (e : InputEvent) => {
		teamId.value = e.detail.value
	}

	const onNameInput = (e : InputEvent) => {
		name.value = e.detail.value
	}

	const onMemberAccountIdInput = (e : InputEvent) => {
		memberAccountId.value = e.detail.value
	}

	const printResult = (title : string, payloadText : string) => {
		resultText.value = title + '\n' + payloadText
		console.log(title, payloadText)
	}

	const appendEvent = (title : string, payloadText : string) => {
		listenerText.value = '[监听] ' + title + '\n' + payloadText + '\n\n' + listenerText.value
		console.log(title, payloadText)
	}

	const handleCreateTeam = () => {
		setStoredString('demo_team_teamId', teamId.value)
		setStoredString('demo_team_name', name.value)
		// Android 侧插件会把对象里的数字 teamType 归一化成原生枚举，其它端继续走 typed 参数。
		ensureService().createTeam({
			teamType: TEAM_TYPE_NORMAL,
			name: name.value,
			avatar: '',
			intro: 'demo intro',
			announcement: 'demo announcement',
			serverExtension: '{}',
			memberLimit: 100
		}, null, null, null).then((res) => {
			printResult('createTeam', JSON.stringify(res))
			if (res.code == 200 && res.data != null && res.data!.team != null) {
				teamId.value = res.data!.team!.teamId
				setStoredString('demo_team_teamId', teamId.value)
			}
			uni.showToast({ title: res.code == 200 ? '创建成功' : '创建失败', icon: 'none' })
		})
	}

	const handleGetJoinedTeamList = () => {
		ensureService().getJoinedTeamList(null).then((res) => {
			printResult('getJoinedTeamList', JSON.stringify(res))
			if (res.code == 200 && res.data != null && res.data!.length > 0) {
				teamId.value = res.data![0].teamId
				name.value = res.data![0].name
				setStoredString('demo_team_teamId', teamId.value)
				setStoredString('demo_team_name', name.value)
			}
			uni.showToast({ title: res.code == 200 ? '获取成功' : '获取失败', icon: 'none' })
		})
	}

	const handleGetTeamInfo = () => {
		ensureService().getTeamInfo(teamId.value, TEAM_TYPE_NORMAL).then((res) => {
			printResult('getTeamInfo', JSON.stringify(res))
			uni.showToast({ title: res.code == 200 ? '获取成功' : '获取失败', icon: 'none' })
		})
	}

	const handleGetTeamMemberList = () => {
		ensureService().getTeamMemberList(teamId.value, TEAM_TYPE_NORMAL, {
			limit: 20,
			onlyChatBanned: false,
			nextToken: ''
		}).then((res) => {
			printResult('getTeamMemberList', JSON.stringify(res))
			if (res.code == 200 && res.data != null && res.data!.memberList.length > 0) {
				memberAccountId.value = res.data!.memberList[0].accountId
				setStoredString('demo_team_memberAccountId', memberAccountId.value)
			}
			uni.showToast({ title: res.code == 200 ? '获取成功' : '获取失败', icon: 'none' })
		})
	}

	const toggleListener = () => {
		const service = ensureService()
		if (listenerEnabled.value) {
			if (teamListener != null) {
				service.removeTeamListener(teamListener!)
			}
			teamListener = null
			listenerEnabled.value = false
		} else {
			const listener : V2NIMTeamListener = {
				onSyncStarted() { appendEvent('onSyncStarted', 'started') },
				onSyncFinished() { appendEvent('onSyncFinished', 'finished') },
				onSyncFailed(error) { appendEvent('onSyncFailed', JSON.stringify(error)) },
				onTeamCreated(team) { appendEvent('onTeamCreated', JSON.stringify(team)) },
				onTeamInfoUpdated(team) { appendEvent('onTeamInfoUpdated', JSON.stringify(team)) },
				onTeamDismissed(team) { appendEvent('onTeamDismissed', JSON.stringify(team)) },
				onTeamJoined(team) { appendEvent('onTeamJoined', JSON.stringify(team)) },
				onTeamLeft(team, isKicked) {
					appendEvent('onTeamLeft', JSON.stringify({ team: team, isKicked: isKicked }))
				},
				onTeamMemberJoined(teamMembers) { appendEvent('onTeamMemberJoined', JSON.stringify(teamMembers)) },
				onTeamMemberKicked(operatorAccountId, teamMembers) {
					appendEvent('onTeamMemberKicked', JSON.stringify({ operatorAccountId: operatorAccountId, teamMembers: teamMembers }))
				},
				onTeamMemberLeft(teamMembers) { appendEvent('onTeamMemberLeft', JSON.stringify(teamMembers)) },
				onTeamMemberInfoUpdated(teamMembers) { appendEvent('onTeamMemberInfoUpdated', JSON.stringify(teamMembers)) },
				onReceiveTeamJoinActionInfo(joinActionInfo) { appendEvent('onReceiveTeamJoinActionInfo', JSON.stringify(joinActionInfo)) }
			}
			teamListener = listener
			service.addTeamListener(listener)
			listenerEnabled.value = true
		}
	}
</script>

<style>
	.page { flex: 1; padding: 24rpx; background-color: #f5f7fb; }
	.panel { margin-bottom: 24rpx; padding: 24rpx; border-radius: 16rpx; background-color: #ffffff; border-width: 1rpx; border-color: #e5e8ef; }
	.title { font-size: 38rpx; font-weight: 600; color: #111827; }
	.sub-title { margin-top: 12rpx; font-size: 26rpx; color: #6b7280; }
	.panel-title { margin-bottom: 18rpx; font-size: 30rpx; font-weight: 600; color: #1f2937; }
	.field { margin-bottom: 18rpx; }
	.label { margin-bottom: 10rpx; font-size: 24rpx; color: #6b7280; }
	.input { height: 72rpx; padding-left: 20rpx; padding-right: 20rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; }
	.action-btn { margin-bottom: 16rpx; border-radius: 12rpx; background-color: #f8fafc; color: #111827; font-size: 28rpx; }
	.action-primary { background-color: #2563eb; color: #ffffff; }
	.state-text { font-size: 24rpx; }
	.state-on { color: #16a34a; }
	.state-off { color: #9ca3af; }
	.result-panel { margin-bottom: 48rpx; }
	.listener-box { width: 100%; height: 240rpx; margin-top: 12rpx; padding: 18rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; font-size: 24rpx; line-height: 34rpx; }
	.result-box { width: 100%; height: 360rpx; padding: 18rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; font-size: 24rpx; line-height: 34rpx; }
</style>
