<template>
	<scroll-view class="page" :scroll-y="true">
		<view class="panel">
			<text class="title">nim-uts-sdk Demo</text>
			<text class="sub-title">初始化和登录分开操作，下面进入各模块测试页。</text>
		</view>

		<view class="panel">
			<text class="panel-title">初始化</text>
			<view class="field">
				<text class="label">appkey</text>
				<input class="input" :value="appkey" @input="onAppkeyInput" />
			</view>
			<view class="button-row">
				<button class="action-btn action-primary" @tap="handleInit">初始化</button>
				<text class="state-text" :class="initialized ? 'state-on' : 'state-off'">
					{{ initialized ? '已初始化' : '未初始化' }}
				</text>
			</view>
		</view>

		<view class="panel">
			<text class="panel-title">登录</text>
			<view class="field">
				<text class="label">账号 ID</text>
				<input class="input" :value="accountId" @input="onAccountIdInput" />
			</view>
			<view class="field">
				<text class="label">Token</text>
				<input class="input" :value="token" @input="onTokenInput" />
			</view>
			<view class="button-row">
				<button class="action-btn action-primary" :disabled="!initialized" @tap="handleLogin">登录</button>
				<!-- #ifdef APP-ANDROID || APP-HARMONY -->
				<button class="action-btn" :disabled="!initialized" @tap="handleLoginWithProviders">动态 Token 登录</button>
				<!-- #endif -->
				<button class="action-btn" @tap="handleLogout">登出</button>
			</view>
			<text class="state-text" :class="loginStatus === 'logined' ? 'state-on' : 'state-off'">
				当前状态：{{ loginStatus }}
			</text>
			<textarea class="listener-box" :value="listenerText" disabled />
		</view>

		<view class="panel">
			<text class="panel-title">模块页面</text>
			<button class="nav-btn" @tap="goPage('/pages/user/user')">用户</button>
			<button class="nav-btn" @tap="goPage('/pages/friend/friend')">好友</button>
			<button class="nav-btn" @tap="goPage('/pages/local-conversation/local-conversation')">本地会话</button>
			<button class="nav-btn" @tap="goPage('/pages/message/message')">消息</button>
			<button class="nav-btn" @tap="goPage('/pages/team/team')">群</button>
		</view>

		<view class="panel result-panel">
			<text class="panel-title">结果</text>
			<textarea class="result-box" :value="resultText" disabled />
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import {
		initNIMSDK,
		NIMFail,
		NIMInitSuccess,
		V2NIMLoginListener,
		V2NIMLoginService
	} from '@/uni_modules/nim-uts-sdk'
	// 蒸汽模式（Android/Harmony）下使用插件的 JSON 初始化入口，避免 options 实例跨桥。
	// iOS/Web 仍使用旧的 initNIMSDK(options)。
	// #ifdef APP-ANDROID
	import { initNIMSDKJson } from '@/uni_modules/nim-uts-sdk'
	// #endif
	// #ifdef APP-HARMONY
	import { initNIMSDKJson } from '@/uni_modules/nim-uts-sdk'
	// #endif
	// #ifdef APP-IOS
	import { SDKOptions } from '@/uni_modules/nim-uts-sdk'
	// #endif
	import { getStoredString, setStoredString } from '../common/demo-utils.uts'

	type DemoLoginConfig = {
		appKey : string,
		accountId : string,
		token : string
	}

	// Demo 默认登录信息。其他使用者只需要修改这里的 appKey、accountId、token。
	// 页面输入框仍会优先读取本地缓存；如果想恢复这里的默认值，可清理应用缓存后重新打开 Demo。
	const DEMO_LOGIN_CONFIG : DemoLoginConfig = {
		appKey: '3e215d27b6a6a9e27dad7ef36dd5b65c',
		accountId: '334665458163968',
		token: '8d5ca2c8-9c02-481c-9908-ca1e96038788'
	}

	const appkey = ref(getStoredString('demo_appkey', DEMO_LOGIN_CONFIG.appKey) as string)
	const accountId = ref(getStoredString('demo_accountId', DEMO_LOGIN_CONFIG.accountId) as string)
	const token = ref(getStoredString('demo_token', DEMO_LOGIN_CONFIG.token) as string)
	// 初始化状态只代表当前进程的原生 SDK 实例，不能跨进程持久化。
	const initialized = ref(false as boolean)
	const loginStatus = ref('logout' as string)
	const resultText = ref('暂无结果' as string)
	const listenerText = ref('暂无监听内容' as string)

	let loginService : V2NIMLoginService | null = null

	// 蒸汽模式下页面逻辑层是 JS：插件不再导出枚举对象，入参枚举一律用数字（与插件 Android 层约定），
	// 数值取自 utssdk/types/Enum.uts。
	const LOGIN_STATUS_LOGINED : number = 1
	const LOGIN_STATUS_LOGINING : number = 2
	const DATA_SYNC_LEVEL_FULL : number = 0

	const onAppkeyInput = (e : InputEvent) => {
		appkey.value = e.detail.value
	}

	const onAccountIdInput = (e : InputEvent) => {
		accountId.value = e.detail.value
	}

	const onTokenInput = (e : InputEvent) => {
		token.value = e.detail.value
	}

	const printResult = (title : string, payloadText : string) => {
		resultText.value = title + '\n' + payloadText
		console.log(title, payloadText)
	}

	const appendEvent = (title : string, payloadText : string) => {
		listenerText.value = '[监听] ' + title + '\n' + payloadText + '\n\n' + listenerText.value
		console.log(title, payloadText)
	}

	// iOS 仍使用 SDKOptions 入口；Android/Harmony 蒸汽模式走 initNIMSDKJson。
	// #ifdef APP-IOS
	const buildOptions = () : SDKOptions => {
		return { appKey: appkey.value } as SDKOptions
	}
	// #endif

	const ensureLoginService = () => {
		if (loginService == null) {
			const service = new V2NIMLoginService()
			loginService = service
			const listener : V2NIMLoginListener = {
				onLoginStatus(status) {
					if (status == LOGIN_STATUS_LOGINED) {
						loginStatus.value = 'logined'
					} else if (status == LOGIN_STATUS_LOGINING) {
						loginStatus.value = 'logining'
					} else {
						loginStatus.value = 'logout'
					}
					appendEvent('onLoginStatus', JSON.stringify(status))
				},
				onLoginFailed(error) {
					appendEvent('onLoginFailed', JSON.stringify(error))
				}
			}
			service.addLoginListener(listener)
		}
	}

	const onInitSuccess = (res : NIMInitSuccess) => {
		initialized.value = true
		setStoredString('demo_appkey', appkey.value)
		printResult('initNIMSDK success', JSON.stringify(res))
		uni.showToast({ title: '初始化成功', icon: 'success' })
	}

	const onInitFail = (err : NIMFail) => {
		printResult('initNIMSDK fail', JSON.stringify(err))
		uni.showToast({ title: '初始化失败', icon: 'none' })
	}

	const handleInit = () => {
		if (initialized.value) {
			uni.showToast({ title: '已初始化，无需重复初始化', icon: 'none' })
			return
		}
		// 蒸汽模式（页面逻辑层是 JS）下，嵌套在对象里的 SDKOptions 实例过桥会退化成 UTSJSONObject，
		// 调 initNIMSDK({ options: ... }) 会抛 ClassCastException；
		// Android/Harmony 改用 initNIMSDKJson：配置走 JSON，结果走 Promise。
		// #ifdef APP-ANDROID
		initNIMSDKJson({
			appKey: appkey.value
		} as UTSJSONObject).then((res) => {
			if (res.code == 200) {
				initialized.value = true
				setStoredString('demo_appkey', appkey.value)
				printResult('initNIMSDKJson success', JSON.stringify(res))
				uni.showToast({ title: '初始化成功', icon: 'success' })
			} else {
				initialized.value = false
				printResult('initNIMSDKJson fail', JSON.stringify(res))
				uni.showToast({ title: res.desc.length > 0 ? res.desc : '初始化失败', icon: 'none' })
			}
		})
		// #endif
		// #ifdef APP-HARMONY
		initNIMSDKJson({
			appKey: appkey.value
		} as UTSJSONObject).then((res) => {
			if (res.code == 200) {
				initialized.value = true
				setStoredString('demo_appkey', appkey.value)
				printResult('initNIMSDKJson success', JSON.stringify(res))
				uni.showToast({ title: '初始化成功', icon: 'success' })
			} else {
				initialized.value = false
				printResult('initNIMSDKJson fail', JSON.stringify(res))
				uni.showToast({ title: res.desc.length > 0 ? res.desc : '初始化失败', icon: 'none' })
			}
		})
		// #endif
		// #ifdef APP-IOS
		initNIMSDK({
			options: buildOptions(),
			success: onInitSuccess,
			fail: onInitFail
		})
		// #endif
	}

	const handleLogin = () => {
		if (!initialized.value) {
			uni.showToast({ title: '请先初始化', icon: 'none' })
			return
		}
		ensureLoginService()
		// SDK 撤回了 loginJson：Android 的 login 实现本身接收 UTSJSONObject 并解析数字枚举，
		// 其它端继续传 typed option，这里统一传对象字面量即可。
		loginService!.login(accountId.value, token.value, {
			syncLevel: DATA_SYNC_LEVEL_FULL
		}).then((res) => {
			if (res.code == 200) {
				loginStatus.value = 'logined'
				setStoredString('demo_accountId', accountId.value)
				setStoredString('demo_token', token.value)
				uni.showToast({ title: '登录成功', icon: 'success' })
			} else {
				uni.showToast({ title: res.desc.length > 0 ? res.desc : '登录失败', icon: 'none' })
			}
			printResult('login', JSON.stringify(res))
		})
	}

	// #ifdef APP-ANDROID || APP-HARMONY
	// 动态 token / 第三方回调鉴权的 provider 必须作为顶层函数参数传入，不能塞进 option。
	// 当前测试 appkey 未开启动态 token 时，原生会返回 invalid token，但调用链可以正常走通。
	const handleLoginWithProviders = () => {
		if (!initialized.value) {
			uni.showToast({ title: '请先初始化', icon: 'none' })
			return
		}
		ensureLoginService()
		// provider 是同步函数，提前把当前 token 捕获成局部变量，避免 vapor 下直接读 ref。
		const currentToken = token.value
		loginService!.loginWithProviders(accountId.value, currentToken, {
			authType: 1,
			syncLevel: DATA_SYNC_LEVEL_FULL
		} as UTSJSONObject, (currentAccountId : string) : string => {
			return currentToken
		}, null).then((res) => {
			if (res.code == 200) {
				loginStatus.value = 'logined'
				setStoredString('demo_accountId', accountId.value)
				setStoredString('demo_token', token.value)
				uni.showToast({ title: '动态 Token 登录成功', icon: 'success' })
			} else {
				uni.showToast({ title: res.desc.length > 0 ? res.desc : '动态 Token 登录失败', icon: 'none' })
			}
			printResult('loginWithProviders', JSON.stringify(res))
		})
	}
	// #endif

	const handleLogout = () => {
		const service = loginService
		if (service == null) {
			uni.showToast({ title: '请先登录', icon: 'none' })
			return
		}
		service.logout().then((res) => {
			if (res.code == 200) {
				loginStatus.value = 'logout'
				uni.showToast({ title: '已登出', icon: 'success' })
			} else {
				uni.showToast({ title: res.desc.length > 0 ? res.desc : '登出失败', icon: 'none' })
			}
			printResult('logout', JSON.stringify(res))
		})
	}

	const goPage = (url : string) => {
		uni.navigateTo({ url: url })
	}
</script>

<style>
	.page {
		flex: 1;
		padding: 24rpx;
		background-color: #f5f7fb;
	}

	.panel {
		margin-bottom: 24rpx;
		padding: 24rpx;
		border-radius: 16rpx;
		background-color: #ffffff;
		border-width: 1rpx;
		border-color: #e5e8ef;
	}

	.title {
		font-size: 38rpx;
		font-weight: 600;
		color: #111827;
	}

	.sub-title {
		margin-top: 12rpx;
		font-size: 26rpx;
		color: #6b7280;
	}

	.panel-title {
		margin-bottom: 18rpx;
		font-size: 30rpx;
		font-weight: 600;
		color: #1f2937;
	}

	.field {
		margin-bottom: 18rpx;
	}

	.label {
		margin-bottom: 10rpx;
		font-size: 24rpx;
		color: #6b7280;
	}

	.input {
		height: 72rpx;
		padding-left: 20rpx;
		padding-right: 20rpx;
		border-radius: 12rpx;
		background-color: #f8fafc;
		border-width: 1rpx;
		border-color: #dbe1ea;
		color: #111827;
	}

	.button-row {
		flex-direction: row;
		align-items: center;
		margin-top: 8rpx;
		margin-bottom: 12rpx;
	}

	.action-btn {
		margin-right: 16rpx;
		padding-left: 24rpx;
		padding-right: 24rpx;
		border-radius: 12rpx;
		background-color: #e8edf5;
		color: #111827;
		font-size: 28rpx;
	}

	.action-primary {
		background-color: #2563eb;
		color: #ffffff;
	}

	.state-text {
		font-size: 24rpx;
	}

	.state-on {
		color: #16a34a;
	}

	.state-off {
		color: #9ca3af;
	}

	.nav-btn {
		margin-bottom: 16rpx;
		padding-left: 24rpx;
		padding-right: 24rpx;
		border-radius: 12rpx;
		background-color: #f8fafc;
		color: #111827;
		font-size: 28rpx;
	}

	.result-panel {
		margin-bottom: 48rpx;
	}

	.listener-box {
		width: 100%;
		height: 240rpx;
		margin-top: 12rpx;
		padding: 18rpx;
		border-radius: 12rpx;
		background-color: #f8fafc;
		border-width: 1rpx;
		border-color: #dbe1ea;
		color: #111827;
		font-size: 24rpx;
		line-height: 34rpx;
	}

	.result-box {
		width: 100%;
		height: 360rpx;
		padding: 18rpx;
		border-radius: 12rpx;
		background-color: #f8fafc;
		border-width: 1rpx;
		border-color: #dbe1ea;
		color: #111827;
		font-size: 24rpx;
		line-height: 34rpx;
	}
</style>
