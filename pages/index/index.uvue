<template>
	<scroll-view class="page" scroll-y="true">
		<view class="panel">
			<text class="title">nim-uts-sdk Demo</text>
			<text class="sub-title">初始化和登录分开操作，下面进入各模块测试页。</text>
		</view>

		<view class="panel">
			<text class="panel-title">初始化</text>
			<view class="field">
				<text class="label">appkey</text>
				<input class="input" :value="appkey" @input="onAppkeyInput" />
			</view>
			<view class="button-row">
				<button class="action-btn action-primary" @tap="handleInit">初始化</button>
				<text class="state-text" :class="initialized ? 'state-on' : 'state-off'">
					{{ initialized ? '已初始化' : '未初始化' }}
				</text>
			</view>
		</view>

		<view class="panel">
			<text class="panel-title">登录</text>
			<view class="field">
				<text class="label">账号 ID</text>
				<input class="input" :value="accountId" @input="onAccountIdInput" />
			</view>
			<view class="field">
				<text class="label">Token</text>
				<input class="input" :value="token" @input="onTokenInput" />
			</view>
			<view class="button-row">
				<button class="action-btn action-primary" :disabled="!initialized" @tap="handleLogin">登录</button>
				<button class="action-btn" @tap="handleLogout">登出</button>
			</view>
			<text class="state-text" :class="loginStatus === 'logined' ? 'state-on' : 'state-off'">
				当前状态：{{ loginStatus }}
			</text>
			<textarea class="listener-box" :value="listenerText" disabled />
		</view>

		<view class="panel">
			<text class="panel-title">模块页面</text>
			<button class="nav-btn" @tap="goPage('/pages/user/user')">用户</button>
			<button class="nav-btn" @tap="goPage('/pages/friend/friend')">好友</button>
			<button class="nav-btn" @tap="goPage('/pages/local-conversation/local-conversation')">本地会话</button>
			<button class="nav-btn" @tap="goPage('/pages/message/message')">消息</button>
			<button class="nav-btn" @tap="goPage('/pages/team/team')">群</button>
		</view>

		<view class="panel result-panel">
			<text class="panel-title">结果</text>
			<textarea class="result-box" :value="resultText" disabled />
		</view>
	</scroll-view>
</template>

<script lang="uts">
	import {
		initNIMSDK,
		SDKOptions,
		V2NIMLoginListener,
		V2NIMLoginService
	} from '@/uni_modules/nim-uts-sdk'
	// #ifdef APP-ANDROID
	import { AndroidSDKOptions } from '@/uni_modules/nim-uts-sdk'
	// #endif
	// #ifdef APP-HARMONY
	import { HarmonySDKOptions } from '@/uni_modules/nim-uts-sdk'
	// #endif
	import { getStoredBoolean, getStoredString, setStoredBoolean, setStoredString } from '../common/demo-utils.uts'

	const LOGIN_STATUS_LOGINED = 1
	const LOGIN_STATUS_LOGINING = 2
	const DATA_SYNC_LEVEL_FULL = 0

	type DemoLoginConfig = {
		appKey : string,
		accountId : string,
		token : string
	}

	// Demo 默认登录信息。其他使用者只需要修改这里的 appKey、accountId、token。
	// 页面输入框仍会优先读取本地缓存；如果想恢复这里的默认值，可清理应用缓存后重新打开 Demo。
	const DEMO_LOGIN_CONFIG : DemoLoginConfig = {
		appKey: 'your yunxin appKey',
		accountId: 'login account id',
		token: 'login token'
	}

	let loginService : V2NIMLoginService | null = null

	export default {
		data() {
			return {
				appkey: getStoredString('demo_appkey', DEMO_LOGIN_CONFIG.appKey),
				accountId: getStoredString('demo_accountId', DEMO_LOGIN_CONFIG.accountId),
				token: getStoredString('demo_token', DEMO_LOGIN_CONFIG.token),
				initialized: getStoredBoolean('demo_initialized', false),
				loginStatus: 'logout',
				resultText: '暂无结果',
				listenerText: '暂无监听内容'
			}
		},
		methods: {
			onAppkeyInput(e : InputEvent) {
				this.appkey = e.detail.value
			},
			onAccountIdInput(e : InputEvent) {
				this.accountId = e.detail.value
			},
			onTokenInput(e : InputEvent) {
				this.token = e.detail.value
			},
			printResult(title : string, payloadText : string) {
				this.resultText = title + '\n' + payloadText
				console.log(title, payloadText)
			},
			appendEvent(title : string, payloadText : string) {
				this.listenerText = '[监听] ' + title + '\n' + payloadText + '\n\n' + this.listenerText
				console.log(title, payloadText)
			},
			buildOptions() : SDKOptions {
				let options : SDKOptions
				// #ifdef APP-ANDROID
				const androidOptions = new AndroidSDKOptions()
				androidOptions.appKey = this.appkey
				options = androidOptions
				// #endif
				// #ifdef APP-HARMONY
				const harmonyOptions = new HarmonySDKOptions()
				harmonyOptions.appKey = this.appkey
				options = harmonyOptions
				// #endif
				// #ifdef APP-IOS
				options = { appKey: this.appkey } as SDKOptions
				// #endif
				return options
			},
			ensureLoginService() {
				if (loginService == null) {
					loginService = new V2NIMLoginService()
					const self = this
					loginService.addLoginListener({
						onLoginStatus(status) {
							if (status == LOGIN_STATUS_LOGINED) {
								self.loginStatus = 'logined'
							} else if (status == LOGIN_STATUS_LOGINING) {
								self.loginStatus = 'logining'
							} else {
								self.loginStatus = 'logout'
							}
							self.appendEvent('onLoginStatus', JSON.stringify(status))
						},
						onLoginFailed(error) {
							self.appendEvent('onLoginFailed', JSON.stringify(error))
						}
					} as V2NIMLoginListener)
				}
			},
			handleInit() {
				initNIMSDK({
					options: this.buildOptions(),
					success: (res) => {
						this.initialized = true
						setStoredBoolean('demo_initialized', true)
						setStoredString('demo_appkey', this.appkey)
						this.printResult('initNIMSDK success', JSON.stringify(res))
						uni.showToast({ title: '初始化成功', icon: 'success' })
					},
					fail: (err) => {
						this.printResult('initNIMSDK fail', JSON.stringify(err))
						uni.showToast({ title: '初始化失败', icon: 'none' })
					}
				})
			},
			handleLogin() {
				if (!this.initialized) {
					uni.showToast({ title: '请先初始化', icon: 'none' })
					return
				}
				this.ensureLoginService()
				loginService!.login(this.accountId, this.token, {
					syncLevel: DATA_SYNC_LEVEL_FULL
				}).then((res) => {
					if (res.code == 200) {
						this.loginStatus = 'logined'
						setStoredString('demo_accountId', this.accountId)
						setStoredString('demo_token', this.token)
						uni.showToast({ title: '登录成功', icon: 'success' })
					} else {
						uni.showToast({ title: res.desc.length > 0 ? res.desc : '登录失败', icon: 'none' })
					}
					this.printResult('login', JSON.stringify(res))
				})
			},
			handleLogout() {
				if (loginService == null) {
					uni.showToast({ title: '请先登录', icon: 'none' })
					return
				}
				loginService.logout().then((res) => {
					if (res.code == 200) {
						this.loginStatus = 'logout'
						uni.showToast({ title: '已登出', icon: 'success' })
					} else {
						uni.showToast({ title: res.desc.length > 0 ? res.desc : '登出失败', icon: 'none' })
					}
					this.printResult('logout', JSON.stringify(res))
				})
			},
			goPage(url : string) {
				uni.navigateTo({ url: url })
			}
		}
	}
</script>

<style>
	.page {
		flex: 1;
		padding: 24rpx;
		background-color: #f5f7fb;
	}

	.panel {
		margin-bottom: 24rpx;
		padding: 24rpx;
		border-radius: 16rpx;
		background-color: #ffffff;
		border-width: 1rpx;
		border-color: #e5e8ef;
	}

	.title {
		font-size: 38rpx;
		font-weight: 600;
		color: #111827;
	}

	.sub-title {
		margin-top: 12rpx;
		font-size: 26rpx;
		color: #6b7280;
	}

	.panel-title {
		margin-bottom: 18rpx;
		font-size: 30rpx;
		font-weight: 600;
		color: #1f2937;
	}

	.field {
		margin-bottom: 18rpx;
	}

	.label {
		margin-bottom: 10rpx;
		font-size: 24rpx;
		color: #6b7280;
	}

	.input {
		height: 72rpx;
		padding-left: 20rpx;
		padding-right: 20rpx;
		border-radius: 12rpx;
		background-color: #f8fafc;
		border-width: 1rpx;
		border-color: #dbe1ea;
		color: #111827;
	}

	.button-row {
		flex-direction: row;
		align-items: center;
		margin-top: 8rpx;
		margin-bottom: 12rpx;
	}

	.action-btn {
		margin-right: 16rpx;
		padding-left: 24rpx;
		padding-right: 24rpx;
		border-radius: 12rpx;
		background-color: #e8edf5;
		color: #111827;
		font-size: 28rpx;
	}

	.action-primary {
		background-color: #2563eb;
		color: #ffffff;
	}

	.state-text {
		font-size: 24rpx;
	}

	.state-on {
		color: #16a34a;
	}

	.state-off {
		color: #9ca3af;
	}

	.nav-btn {
		margin-bottom: 16rpx;
		padding-left: 24rpx;
		padding-right: 24rpx;
		border-radius: 12rpx;
		background-color: #f8fafc;
		color: #111827;
		font-size: 28rpx;
	}

	.result-panel {
		margin-bottom: 48rpx;
	}

	.listener-box {
		width: 100%;
		height: 240rpx;
		margin-top: 12rpx;
		padding: 18rpx;
		border-radius: 12rpx;
		background-color: #f8fafc;
		border-width: 1rpx;
		border-color: #dbe1ea;
		color: #111827;
		font-size: 24rpx;
		line-height: 34rpx;
	}

	.result-box {
		width: 100%;
		height: 360rpx;
		padding: 18rpx;
		border-radius: 12rpx;
		background-color: #f8fafc;
		border-width: 1rpx;
		border-color: #dbe1ea;
		color: #111827;
		font-size: 24rpx;
		line-height: 34rpx;
	}
</style>
