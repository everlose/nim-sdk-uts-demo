<template>
	<scroll-view class="page" scroll-y="true">
		<view class="panel">
			<text class="title">本地会话</text>
			<text class="sub-title">保留 5 个常用接口。</text>
		</view>

		<view class="panel">
			<text class="panel-title">参数</text>
			<view class="field">
				<text class="label">会话 ID</text>
				<input class="input" :value="conversationId" @input="onConversationIdInput" />
			</view>
			<view class="field">
				<text class="label">列表数量</text>
				<input class="input" :value="limitText" @input="onLimitInput" />
			</view>
			<view class="field">
				<text class="label">监听状态</text>
				<text class="state-text" :class="listenerEnabled ? 'state-on' : 'state-off'">
					{{ listenerEnabled ? '已开启' : '未开启' }}
				</text>
			</view>
			<textarea class="listener-box" :value="listenerText" disabled />
		</view>

		<view class="panel">
			<text class="panel-title">接口</text>
			<button class="action-btn action-primary" @tap="handleGetConversationList">获取会话列表</button>
			<button class="action-btn action-primary" @tap="handleCreateConversation">创建会话</button>
			<button class="action-btn action-primary" @tap="handleDeleteConversation">删除会话</button>
			<button class="action-btn action-primary" @tap="handleStickTopConversation">置顶会话</button>
			<button class="action-btn" @tap="toggleListener">{{ listenerEnabled ? '关闭监听' : '开启监听' }}</button>
		</view>

		<view class="panel result-panel">
			<text class="panel-title">结果</text>
			<textarea class="result-box" :value="resultText" disabled />
		</view>
	</scroll-view>
</template>

<script lang="uts">
	import {
		V2NIMLocalConversationListener,
		V2NIMLocalConversationService
	} from '@/uni_modules/nim-uts-sdk'
	import { getStoredString, setStoredString } from '../common/demo-utils.uts'

	let localConversationService : V2NIMLocalConversationService | null = null
	let listenerEnabled = false
	let localConversationListener : V2NIMLocalConversationListener | null = null

	export default {
		data() {
			return {
				conversationId: '',
				limitText: getStoredString('demo_local_limit', '20'),
				listenerEnabled: listenerEnabled,
				resultText: '暂无结果',
				listenerText: '暂无监听内容'
			}
		},
		methods: {
			ensureService() : V2NIMLocalConversationService {
				if (localConversationService == null) {
					localConversationService = new V2NIMLocalConversationService()
				}
				return localConversationService!
			},
			getLimit() : number {
				const value = parseInt(this.limitText)
				if (isNaN(value)) {
					return 20
				}
				return value
			},
			onConversationIdInput(e : InputEvent) { this.conversationId = e.detail.value },
			onLimitInput(e : InputEvent) { this.limitText = e.detail.value },
			printResult(title : string, payloadText : string) {
				this.resultText = title + '\n' + payloadText
				console.log(title, payloadText)
			},
			appendEvent(title : string, payloadText : string) {
				this.listenerText = '[监听] ' + title + '\n' + payloadText + '\n\n' + this.listenerText
				console.log(title, payloadText)
			},
			handleGetConversationList() {
				this.ensureService().getConversationList(0, this.getLimit()).then((res) => {
					this.printResult('getConversationList', JSON.stringify(res))
					if (res.code == 200 && res.data != null && res.data!.conversationList.length > 0) {
						this.conversationId = res.data!.conversationList[0].conversationId
						setStoredString('demo_local_conversationId', this.conversationId)
					}
					uni.showToast({ title: res.code == 200 ? '获取成功' : '获取失败', icon: 'none' })
				})
			},
			handleCreateConversation() {
				setStoredString('demo_local_conversationId', this.conversationId)
				this.ensureService().createConversation(this.conversationId).then((res) => {
					this.printResult('createConversation', JSON.stringify(res))
					uni.showToast({ title: res.code == 200 ? '创建成功' : '创建失败', icon: 'none' })
				})
			},
			handleDeleteConversation() {
				this.ensureService().deleteConversation(this.conversationId, true).then((res) => {
					this.printResult('deleteConversation', JSON.stringify(res))
					uni.showToast({ title: res.code == 200 ? '删除成功' : '删除失败', icon: 'none' })
				})
			},
			handleStickTopConversation() {
				this.ensureService().stickTopConversation(this.conversationId, true).then((res) => {
					this.printResult('stickTopConversation', JSON.stringify(res))
					uni.showToast({ title: res.code == 200 ? '已置顶' : '置顶失败', icon: 'none' })
				})
			},
			toggleListener() {
				const service = this.ensureService()
				if (listenerEnabled) {
					if (localConversationListener != null) {
						service.removeConversationListener(localConversationListener!)
					}
					localConversationListener = null
					listenerEnabled = false
				} else {
					const self = this
					localConversationListener = {
						onSyncStarted() { self.appendEvent('onSyncStarted', 'started') },
						onSyncFinished() { self.appendEvent('onSyncFinished', 'finished') },
						onSyncFailed(error) { self.appendEvent('onSyncFailed', JSON.stringify(error)) },
						onConversationCreated(conversation) { self.appendEvent('onConversationCreated', JSON.stringify(conversation)) },
						onConversationChanged(conversationList) { self.appendEvent('onConversationChanged', JSON.stringify(conversationList)) },
						onConversationDeleted(conversationIds) { self.appendEvent('onConversationDeleted', JSON.stringify(conversationIds)) },
						onConversationReadTimeUpdated(conversationId, readTime) {
							self.appendEvent('onConversationReadTimeUpdated', JSON.stringify({ conversationId: conversationId, readTime: readTime }))
						},
						onTotalUnreadCountChanged(unreadCount) { self.appendEvent('onTotalUnreadCountChanged', JSON.stringify(unreadCount)) },
						onUnreadCountChangedByFilter(filter, unreadCount) {
							self.appendEvent('onUnreadCountChangedByFilter', JSON.stringify({ filter: filter, unreadCount: unreadCount }))
						}
					} as V2NIMLocalConversationListener
					service.addConversationListener(localConversationListener!)
					listenerEnabled = true
				}
				this.listenerEnabled = listenerEnabled
			}
		}
	}
</script>

<style>
	.page { flex: 1; padding: 24rpx; background-color: #f5f7fb; }
	.panel { margin-bottom: 24rpx; padding: 24rpx; border-radius: 16rpx; background-color: #ffffff; border-width: 1rpx; border-color: #e5e8ef; }
	.title { font-size: 38rpx; font-weight: 600; color: #111827; }
	.sub-title { margin-top: 12rpx; font-size: 26rpx; color: #6b7280; }
	.panel-title { margin-bottom: 18rpx; font-size: 30rpx; font-weight: 600; color: #1f2937; }
	.field { margin-bottom: 18rpx; }
	.label { margin-bottom: 10rpx; font-size: 24rpx; color: #6b7280; }
	.input { height: 72rpx; padding-left: 20rpx; padding-right: 20rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; }
	.action-btn { margin-bottom: 16rpx; border-radius: 12rpx; background-color: #f8fafc; color: #111827; font-size: 28rpx; }
	.action-primary { background-color: #2563eb; color: #ffffff; }
	.state-text { font-size: 24rpx; }
	.state-on { color: #16a34a; }
	.state-off { color: #9ca3af; }
	.result-panel { margin-bottom: 48rpx; }
	.listener-box { width: 100%; height: 240rpx; margin-top: 12rpx; padding: 18rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; font-size: 24rpx; line-height: 34rpx; }
	.result-box { width: 100%; height: 360rpx; padding: 18rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; font-size: 24rpx; line-height: 34rpx; }
</style>
