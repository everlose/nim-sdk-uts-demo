<template>
	<scroll-view class="page" scroll-y="true">
		<view class="panel">
			<text class="title">用户</text>
			<text class="sub-title">保留 5 个常用接口。</text>
		</view>

		<view class="panel">
			<text class="panel-title">参数</text>
			<view class="field">
				<text class="label">账号列表</text>
				<input class="input" :value="accountIdsText" @input="onAccountIdsInput" />
			</view>
			<view class="field">
				<text class="label">搜索关键字</text>
				<input class="input" :value="keyword" @input="onKeywordInput" />
			</view>
			<view class="field">
				<text class="label">昵称</text>
				<input class="input" :value="name" @input="onNameInput" />
			</view>
			<view class="field">
				<text class="label">签名</text>
				<input class="input" :value="sign" @input="onSignInput" />
			</view>
			<view class="field">
				<text class="label">监听状态</text>
				<text class="state-text" :class="listenerEnabled ? 'state-on' : 'state-off'">
					{{ listenerEnabled ? '已开启' : '未开启' }}
				</text>
			</view>
			<textarea class="listener-box" :value="listenerText" disabled />
		</view>

		<view class="panel">
			<text class="panel-title">接口</text>
			<button class="action-btn action-primary" @tap="handleGetUserList">获取用户列表</button>
			<button class="action-btn action-primary" @tap="handleGetUserListFromCloud">云端获取用户</button>
			<button class="action-btn action-primary" @tap="handleSearchUser">搜索用户</button>
			<button class="action-btn action-primary" @tap="handleUpdateSelfUserProfile">更新自己资料</button>
			<button class="action-btn" @tap="toggleListener">{{ listenerEnabled ? '关闭监听' : '开启监听' }}</button>
		</view>

		<view class="panel result-panel">
			<text class="panel-title">结果</text>
			<textarea class="result-box" :value="resultText" disabled />
		</view>
	</scroll-view>
</template>

<script lang="uts">
	import {
		V2NIMUserService,
		V2NIMUserListener
	} from '@/uni_modules/nim-uts-sdk'
	import { getStoredString, setStoredString } from '../common/demo-utils.uts'

	let userService : V2NIMUserService | null = null
	let listenerEnabled = false
	let userListener : V2NIMUserListener | null = null

	export default {
		data() {
			return {
				accountIdsText: '',
				keyword: getStoredString('demo_user_keyword', '332103'),
				name: getStoredString('demo_user_name', 'demo-name'),
				sign: getStoredString('demo_user_sign', 'demo-sign'),
				listenerEnabled: listenerEnabled,
				resultText: '暂无结果',
				listenerText: '暂无监听内容'
			}
		},
		methods: {
			ensureService() : V2NIMUserService {
				if (userService == null) {
					userService = new V2NIMUserService()
				}
				return userService!
			},
			parseAccountIds() : string[] {
				const text = this.accountIdsText
				const parts = text.split(',')
				const result : string[] = []
				for (let i = 0; i < parts.length; i++) {
					const item = parts[i].trim()
					if (item.length > 0) {
						result.push(item)
					}
				}
				return result
			},
			onAccountIdsInput(e : InputEvent) { this.accountIdsText = e.detail.value },
			onKeywordInput(e : InputEvent) { this.keyword = e.detail.value },
			onNameInput(e : InputEvent) { this.name = e.detail.value },
			onSignInput(e : InputEvent) { this.sign = e.detail.value },
			printResult(title : string, payloadText : string) {
				this.resultText = title + '\n' + payloadText
				console.log(title, payloadText)
			},
			appendEvent(title : string, payloadText : string) {
				this.listenerText = '[监听] ' + title + '\n' + payloadText + '\n\n' + this.listenerText
				console.log(title, payloadText)
			},
			handleGetUserList() {
				const service = this.ensureService()
				const accountIds = this.parseAccountIds()
				service.getUserList(accountIds).then((res) => {
					this.printResult('getUserList', JSON.stringify(res))
					if (res.code == 200 && res.data != null && res.data!.length > 0) {
						this.accountIdsText = res.data![0].accountId
						setStoredString('demo_user_accountIds', this.accountIdsText)
					}
					uni.showToast({ title: res.code == 200 ? '获取成功' : '获取失败', icon: 'none' })
				})
			},
			handleGetUserListFromCloud() {
				const service = this.ensureService()
				const accountIds = this.parseAccountIds()
				service.getUserListFromCloud(accountIds).then((res) => {
					this.printResult('getUserListFromCloud', JSON.stringify(res))
					if (res.code == 200 && res.data != null && res.data!.length > 0) {
						this.accountIdsText = res.data![0].accountId
						setStoredString('demo_user_accountIds', this.accountIdsText)
					}
					uni.showToast({ title: res.code == 200 ? '云端获取成功' : '云端获取失败', icon: 'none' })
				})
			},
			handleSearchUser() {
				const service = this.ensureService()
				service.searchUserByOption({
					keyword: this.keyword,
					searchName: true,
					searchAccountId: true
				}).then((res) => {
					this.printResult('searchUserByOption', JSON.stringify(res))
					if (res.code == 200 && res.data != null && res.data!.length > 0) {
						this.accountIdsText = res.data![0].accountId
						setStoredString('demo_user_accountIds', this.accountIdsText)
					}
					uni.showToast({ title: res.code == 200 ? '搜索成功' : '搜索失败', icon: 'none' })
				})
			},
			handleUpdateSelfUserProfile() {
				setStoredString('demo_user_name', this.name)
				setStoredString('demo_user_sign', this.sign)
				const service = this.ensureService()
				service.updateSelfUserProfile({
					name: this.name,
					sign: this.sign
				}).then((res) => {
					this.printResult('updateSelfUserProfile', JSON.stringify(res))
					uni.showToast({ title: res.code == 200 ? '更新成功' : '更新失败', icon: 'none' })
				})
			},
			toggleListener() {
				const service = this.ensureService()
				if (listenerEnabled) {
					if (userListener != null) {
						service.removeUserListener(userListener!)
					}
					userListener = null
					listenerEnabled = false
				} else {
					const self = this
					userListener = {
						onUserProfileChanged(users) { self.appendEvent('onUserProfileChanged', JSON.stringify(users)) },
						onBlockListAdded(user) { self.appendEvent('onBlockListAdded', JSON.stringify(user)) },
						onBlockListRemoved(accountId) { self.appendEvent('onBlockListRemoved', JSON.stringify(accountId)) }
					} as V2NIMUserListener
					service.addUserListener(userListener!)
					listenerEnabled = true
				}
				this.listenerEnabled = listenerEnabled
			}
		}
	}
</script>

<style>
	.page {
		flex: 1;
		padding: 24rpx;
		background-color: #f5f7fb;
	}
	.panel {
		margin-bottom: 24rpx;
		padding: 24rpx;
		border-radius: 16rpx;
		background-color: #ffffff;
		border-width: 1rpx;
		border-color: #e5e8ef;
	}
	.title { font-size: 38rpx; font-weight: 600; color: #111827; }
	.sub-title { margin-top: 12rpx; font-size: 26rpx; color: #6b7280; }
	.panel-title { margin-bottom: 18rpx; font-size: 30rpx; font-weight: 600; color: #1f2937; }
	.field { margin-bottom: 18rpx; }
	.label { margin-bottom: 10rpx; font-size: 24rpx; color: #6b7280; }
	.input { height: 72rpx; padding-left: 20rpx; padding-right: 20rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; }
	.action-btn { margin-bottom: 16rpx; border-radius: 12rpx; background-color: #f8fafc; color: #111827; font-size: 28rpx; }
	.action-primary { background-color: #2563eb; color: #ffffff; }
	.state-text { font-size: 24rpx; }
	.state-on { color: #16a34a; }
	.state-off { color: #9ca3af; }
	.result-panel { margin-bottom: 48rpx; }
	.listener-box { width: 100%; height: 240rpx; margin-top: 12rpx; padding: 18rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; font-size: 24rpx; line-height: 34rpx; }
	.result-box { width: 100%; height: 360rpx; padding: 18rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; font-size: 24rpx; line-height: 34rpx; }
</style>
