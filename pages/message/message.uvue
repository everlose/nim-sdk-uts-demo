<template>
	<scroll-view class="page" :scroll-y="true">
		<view class="panel">
			<text class="title">消息</text>
			<text class="sub-title">只保留查询消息、创建文本消息、发送消息、消息监听。</text>
		</view>

		<view class="panel">
			<text class="panel-title">参数</text>
			<view class="field">
				<text class="label">会话 ID</text>
				<input class="input" :value="conversationId" @input="onConversationIdInput" />
			</view>
			<view class="field">
				<text class="label">文本内容</text>
				<input class="input" :value="text" @input="onTextInput" />
			</view>
			<view class="field">
				<text class="label">查询条数</text>
				<input class="input" :value="limitText" @input="onLimitInput" />
			</view>
			<view class="field">
				<text class="label">监听状态</text>
				<text class="state-text" :class="listenerEnabled ? 'state-on' : 'state-off'">
					{{ listenerEnabled ? '已开启' : '未开启' }}
				</text>
			</view>
			<textarea class="listener-box" :value="listenerText" disabled />
		</view>

		<view class="panel">
			<text class="panel-title">接口</text>
			<button class="action-btn action-primary" @tap="handleQueryMessages">查询消息</button>
			<button class="action-btn action-primary" @tap="handleCreateTextMessage">创建文本消息</button>
			<button class="action-btn action-primary" @tap="handleSendMessage">发送消息</button>
			<button class="action-btn" @tap="toggleListener">{{ listenerEnabled ? '关闭监听' : '开启监听' }}</button>
		</view>

		<view class="panel result-panel">
			<text class="panel-title">结果</text>
			<textarea class="result-box" :value="resultText" disabled />
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import {
		V2NIMMessage,
		V2NIMMessageCreate,
		V2NIMMessageListener,
		V2NIMMessageService
	} from '@/uni_modules/nim-uts-sdk'
	import { getStoredString, setStoredString } from '../common/demo-utils.uts'

	const conversationId = ref('' as string)
	const text = ref(getStoredString('demo_message_text', 'hello demo') as string)
	const limitText = ref(getStoredString('demo_message_limit', '20') as string)
	const listenerEnabled = ref(false as boolean)
	const resultText = ref('暂无结果' as string)
	const listenerText = ref('暂无监听内容' as string)

	let messageService : V2NIMMessageService | null = null
	// SDK 的 sendMessage / getMessageList 现在接收 any，插件内部按 JSON 归一化，
	// 因此页面仍保存 V2NIMMessage 实例即可，无需再区分 Android / 其它端。
	let createdMessage : V2NIMMessage | null = null
	let messageListener : V2NIMMessageListener | null = null

	const ensureService = () : V2NIMMessageService => {
		if (messageService == null) {
			messageService = new V2NIMMessageService()
		}
		return messageService!
	}

	const getLimit = () : number => {
		const value = parseInt(limitText.value)
		if (isNaN(value)) {
			return 20
		}
		return value
	}

	const onConversationIdInput = (e : InputEvent) => {
		conversationId.value = e.detail.value
	}

	const onTextInput = (e : InputEvent) => {
		text.value = e.detail.value
	}

	const onLimitInput = (e : InputEvent) => {
		limitText.value = e.detail.value
	}

	const printResult = (title : string, payloadText : string) => {
		resultText.value = title + '\n' + payloadText
		console.log(title, payloadText)
	}

	const appendEvent = (title : string, payloadText : string) => {
		listenerText.value = '[监听] ' + title + '\n' + payloadText + '\n\n' + listenerText.value
		console.log(title, payloadText)
	}

	const handleQueryMessages = () => {
		// getMessageList 的 option 可以是对象字面量，Android 侧插件会按 JSON 字段归一化。
		ensureService().getMessageList({
			conversationId: conversationId.value,
			limit: getLimit()
		}).then((res) => {
			printResult('getMessageList', JSON.stringify(res))
			if (res.code == 200 && res.data != null && res.data!.length > 0) {
				conversationId.value = res.data![0].conversationId
				setStoredString('demo_message_conversationId', conversationId.value)
			}
			uni.showToast({ title: res.code == 200 ? '查询成功' : '查询失败', icon: 'none' })
		})
	}

	const handleCreateTextMessage = () => {
		setStoredString('demo_message_text', text.value)
		const creator = new V2NIMMessageCreate()
		createdMessage = creator.createTextMessage(text.value)
		const ok = createdMessage != null
		printResult('createTextMessage', ok ? JSON.stringify(createdMessage) : '创建失败')
		uni.showToast({ title: ok ? '创建成功' : '创建失败', icon: 'none' })
	}

	const handleSendMessage = () => {
		const message = createdMessage
		if (message == null) {
			uni.showToast({ title: '请先创建文本消息', icon: 'none' })
			return
		}
		// sendMessage 接收 any：Android 侧插件会把跨桥后的消息对象还原成原生消息。
		ensureService().sendMessage(message, conversationId.value, null, null).then((res) => {
			printResult('sendMessage', JSON.stringify(res))
			uni.showToast({ title: res.code == 200 ? '发送成功' : '发送失败', icon: 'none' })
		})
	}

	const toggleListener = () => {
		const service = ensureService()
		if (listenerEnabled.value) {
			if (messageListener != null) {
				service.removeMessageListener(messageListener!)
			}
			messageListener = null
			listenerEnabled.value = false
		} else {
			const listener : V2NIMMessageListener = {
				onReceiveMessages(messages) {
					if (messages.length > 0) {
						conversationId.value = messages[0].conversationId
						setStoredString('demo_message_conversationId', conversationId.value)
					}
					appendEvent('onReceiveMessages', JSON.stringify(messages))
				},
				onReceiveMessagesModified(messages) { appendEvent('onReceiveMessagesModified', JSON.stringify(messages)) },
				onSendMessage(message) { appendEvent('onSendMessage', JSON.stringify(message)) },
				onMessageRevokeNotifications(notifications) { appendEvent('onMessageRevokeNotifications', JSON.stringify(notifications)) },
				onMessageDeletedNotifications(notifications) { appendEvent('onMessageDeletedNotifications', JSON.stringify(notifications)) },
				onReceiveP2PMessageReadReceipts(readReceipts) { appendEvent('onReceiveP2PMessageReadReceipts', JSON.stringify(readReceipts)) },
				onReceiveTeamMessageReadReceipts(readReceipts) { appendEvent('onReceiveTeamMessageReadReceipts', JSON.stringify(readReceipts)) }
			}
			messageListener = listener
			service.addMessageListener(listener)
			listenerEnabled.value = true
		}
	}
</script>

<style>
	.page { flex: 1; padding: 24rpx; background-color: #f5f7fb; }
	.panel { margin-bottom: 24rpx; padding: 24rpx; border-radius: 16rpx; background-color: #ffffff; border-width: 1rpx; border-color: #e5e8ef; }
	.title { font-size: 38rpx; font-weight: 600; color: #111827; }
	.sub-title { margin-top: 12rpx; font-size: 26rpx; color: #6b7280; }
	.panel-title { margin-bottom: 18rpx; font-size: 30rpx; font-weight: 600; color: #1f2937; }
	.field { margin-bottom: 18rpx; }
	.label { margin-bottom: 10rpx; font-size: 24rpx; color: #6b7280; }
	.input { height: 72rpx; padding-left: 20rpx; padding-right: 20rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; }
	.action-btn { margin-bottom: 16rpx; border-radius: 12rpx; background-color: #f8fafc; color: #111827; font-size: 28rpx; }
	.action-primary { background-color: #2563eb; color: #ffffff; }
	.state-text { font-size: 24rpx; }
	.state-on { color: #16a34a; }
	.state-off { color: #9ca3af; }
	.result-panel { margin-bottom: 48rpx; }
	.listener-box { width: 100%; height: 240rpx; margin-top: 12rpx; padding: 18rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; font-size: 24rpx; line-height: 34rpx; }
	.result-box { width: 100%; height: 360rpx; padding: 18rpx; border-radius: 12rpx; background-color: #f8fafc; border-width: 1rpx; border-color: #dbe1ea; color: #111827; font-size: 24rpx; line-height: 34rpx; }
</style>
